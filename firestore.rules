rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regole DEMO per sviluppo: consentono lettura/scrittura a chiunque.
    // NON pubblicarle così per un gioco pubblico: chiunque potrebbe falsificare
    // punteggi, modificare stanze o cancellare dati. Aggiungere Firebase Auth e
    // validazioni server-side/Cloud Functions prima di un rilascio aperto.
    match /rooms/{roomId} {
      allow read, write: if true;
    }
  }
}
